<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget: the latest chats, newest first (filled in by widget/LatestWidget.kt) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_bg">
    <TextView android:id="@+id/header" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/app_name" android:textColor="@color/brand" android:textSize="13sp" android:textStyle="bold"
        android:paddingBottom="4dp" />
    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="8dp" android:textColor="#FF6B7280" android:textSize="14sp" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:id="@+id/row0" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="6dp" android:paddingBottom="6dp">
            <TextView android:id="@+id/dot0" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="●" android:textColor="@color/brand" android:textSize="10sp" android:paddingEnd="6dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/title0" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:maxLines="1" android:ellipsize="end" android:textColor="#FF1F2937" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/sub0" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:maxLines="1" android:ellipsize="end" android:textColor="#FF6B7280" android:textSize="13sp" />
            </LinearLayout>
            <TextView android:id="@+id/badge0" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:background="@drawable/widget_badge" android:minWidth="18dp" android:gravity="center"
                android:paddingStart="5dp" android:paddingEnd="5dp" android:textColor="#FFFFFFFF" android:textSize="11sp" android:textStyle="bold"
                android:maxLines="1" android:visibility="gone" />
            <TextView android:id="@+id/ago0" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingStart="8dp" android:textColor="#FF6B7280" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="6dp" android:paddingBottom="6dp">
            <TextView android:id="@+id/dot1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="●" android:textColor="@color/brand" android:textSize="10sp" android:paddingEnd="6dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/title1" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:maxLines="1" android:ellipsize="end" android:textColor="#FF1F2937" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/sub1" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:maxLines="1" android:ellipsize="end" android:textColor="#FF6B7280" android:textSize="13sp" />
            </LinearLayout>
            <TextView android:id="@+id/badge1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:background="@drawable/widget_badge" android:minWidth="18dp" android:gravity="center"
                android:paddingStart="5dp" android:paddingEnd="5dp" android:textColor="#FFFFFFFF" android:textSize="11sp" android:textStyle="bold"
                android:maxLines="1" android:visibility="gone" />
            <TextView android:id="@+id/ago1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingStart="8dp" android:textColor="#FF6B7280" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="6dp" android:paddingBottom="6dp">
            <TextView android:id="@+id/dot2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="●" android:textColor="@color/brand" android:textSize="10sp" android:paddingEnd="6dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/title2" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:maxLines="1" android:ellipsize="end" android:textColor="#FF1F2937" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/sub2" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:maxLines="1" android:ellipsize="end" android:textColor="#FF6B7280" android:textSize="13sp" />
            </LinearLayout>
            <TextView android:id="@+id/badge2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:background="@drawable/widget_badge" android:minWidth="18dp" android:gravity="center"
                android:paddingStart="5dp" android:paddingEnd="5dp" android:textColor="#FFFFFFFF" android:textSize="11sp" android:textStyle="bold"
                android:maxLines="1" android:visibility="gone" />
            <TextView android:id="@+id/ago2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingStart="8dp" android:textColor="#FF6B7280" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="6dp" android:paddingBottom="6dp">
            <TextView android:id="@+id/dot3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="●" android:textColor="@color/brand" android:textSize="10sp" android:paddingEnd="6dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/title3" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:maxLines="1" android:ellipsize="end" android:textColor="#FF1F2937" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/sub3" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:maxLines="1" android:ellipsize="end" android:textColor="#FF6B7280" android:textSize="13sp" />
            </LinearLayout>
            <TextView android:id="@+id/badge3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:background="@drawable/widget_badge" android:minWidth="18dp" android:gravity="center"
                android:paddingStart="5dp" android:paddingEnd="5dp" android:textColor="#FFFFFFFF" android:textSize="11sp" android:textStyle="bold"
                android:maxLines="1" android:visibility="gone" />
            <TextView android:id="@+id/ago3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingStart="8dp" android:textColor="#FF6B7280" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
